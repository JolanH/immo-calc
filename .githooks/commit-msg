#!/bin/sh
# Floor rule: Claude/Anthropic is never author, committer or co-author.
if grep -qiE '^(co-authored-by|signed-off-by):.*(claude|anthropic)' "$1"; then
  echo "commit-msg: remove the Claude/Anthropic trailer (see CONSTRAINTS.md)" >&2; exit 1
fi
ident="$(git var GIT_AUTHOR_IDENT) $(git var GIT_COMMITTER_IDENT)"
if echo "$ident" | grep -qiE 'claude|anthropic'; then
  echo "commit-msg: author/committer must not be Claude (see CONSTRAINTS.md)" >&2; exit 1
fi
